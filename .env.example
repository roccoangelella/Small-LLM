# Copy this file to .env and fill secrets locally. .env is git-ignored.

# Weights & Biases authentication. Never commit the real value.
WANDB_API_KEY=

# Optional W&B user or team. The trainer project defaults to Small-LLM.
WANDB_ENTITY=

# Hugging Face authentication and private storage.
HF_TOKEN=
SMALL_LLM_HF_REPO_ID=
# Optional explicit private Storage Bucket for rolling dataset shards. When
# omitted, dataset tooling derives <SMALL_LLM_HF_REPO_ID>-datasets.
SMALL_LLM_HF_DATASET_BUCKET_ID=
# Legacy checkpoint-bucket restore compatibility only. New Modal checkpoint
# writes use SMALL_LLM_HF_REPO_ID under ADR 0055.
SMALL_LLM_HF_CHECKPOINT_BUCKET_ID=

# Optional separate repository for SFT checkpoints. If blank, SFT tooling can use SMALL_LLM_HF_REPO_ID.
SMALL_LLM_SFT_HF_REPO_ID=

# Optional dedicated repository for the fixed 100M/2B R-SFT profile. The R-SFT
# Kaggle launcher intentionally does not inherit generic 20M-era repository
# variables; when blank it defaults to roccoangelella/small-llm-100m-qualification.
SMALL_LLM_100M_HF_REPO_ID=
SMALL_LLM_RSFT_HF_REPO_ID=

# OpenAI-compatible endpoint and bearer key used by the reasoning-SFT teacher transport.
# Keep the real private endpoint and key only in local/runtime environment configuration.
LLM_ENDPOINT=
GEMR_API_KEY=
