# Copy this file to .env and fill secrets locally. .env is git-ignored.

# Weights & Biases authentication. Never commit the real value.
WANDB_API_KEY=

# Optional W&B user or team. The trainer project defaults to Small-LLM.
WANDB_ENTITY=

# Hugging Face authentication and private storage.
HF_TOKEN=
SMALL_LLM_HF_REPO_ID=
# Optional explicit private Storage Buckets. When omitted, dataset/checkpoint
# tooling derives <SMALL_LLM_HF_REPO_ID>-datasets / -checkpoints.
SMALL_LLM_HF_DATASET_BUCKET_ID=
SMALL_LLM_HF_CHECKPOINT_BUCKET_ID=

# Optional separate repository for SFT checkpoints. If blank, SFT tooling can use SMALL_LLM_HF_REPO_ID.
SMALL_LLM_SFT_HF_REPO_ID=
