# Copy this file to .env and fill secrets locally. .env is git-ignored.

# Weights & Biases authentication. Never commit the real value.
WANDB_API_KEY=

# Optional W&B user or team. The trainer project defaults to Small-LLM.
WANDB_ENTITY=

# Private Hugging Face checkpoint publication.
HF_TOKEN=
SMALL_LLM_HF_REPO_ID=

# Personal Google Drive dataset durability.
SMALL_LLM_GOOGLE_OAUTH_TOKEN=.secrets/google-drive-authorized-user.json
SMALL_LLM_DRIVE_FOLDER_ID=
